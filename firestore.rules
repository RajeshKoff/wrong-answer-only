rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if owns(request.resource.data.uid)
        && request.resource.data.keys().hasOnly(['username', 'uid', 'createdAt'])
        && request.resource.data.username == username
        && username == username.lower()
        && username.size() >= 3
        && username.size() <= 12
        && request.resource.data.createdAt == request.time;
      allow update: if owns(resource.data.uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == resource.data.username;
      allow delete: if false;
    }

    match /players/{uid} {
      allow read, create, update: if owns(uid);
      allow delete: if false;

      match /runs/{runId} {
        allow read: if owns(uid);
        allow create: if owns(uid)
          && request.resource.data.keys().hasOnly([
            'level', 'won', 'score', 'runTimeMs', 'attemptNumber',
            'pickedId', 'wrongId', 'questionId', 'answers', 'reactions', 'completedAt'
          ])
          && request.resource.data.completedAt == request.time;
        allow update, delete: if false;
      }
    }

    match /leaderboard/{uid} {
      allow read: if true;
      allow create, update: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.level is number
        && request.resource.data.score is number;
      allow delete: if false;
    }
  }
}